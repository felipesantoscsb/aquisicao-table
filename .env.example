# ID do Pixel da Meta (encontrado no Gerenciador de Eventos)
META_PIXEL_ID=SEU_PIXEL_ID_AQUI

# Token de acesso da Conversions API (gerado no Gerenciador de Eventos > Configurações)
META_CAPI_TOKEN=SEU_TOKEN_CAPI_AQUI

# Código de teste da CAPI (gerado em Gerenciador de Eventos > Testar Eventos).
# Preencha durante testes e deixe VAZIO ou REMOVA em produção.
META_TEST_EVENT_CODE=

# Segredo compartilhado com o sdr-table para autenticar o forward de leads do quiz e da captação
SDR_WEBHOOK_SECRET=

# Opcional: sobrescreve o endpoint do sdr-table usado pelo formulário /conversa
SDR_LEAD_WEBHOOK_URL=https://table-production-07c5.up.railway.app/webhook/lead

# Segredo compartilhado com o hub-tableclinic para webhooks internos
HUB_WEBHOOK_SECRET=

# Opcional: sobrescreve o endpoint do Hub usado pelo formulário /forms
HUB_PRE_SESSAO_WEBHOOK_URL=https://crm.tableclinic.com.br/webhook/pre-sessao

# Recuperação de checkout via WhatsApp Cloud API
RECOVERY_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECOVERY_TEMPLATE=recuperacao_checkout_raizv2
RECOVERY_BUTTON_MODE=static
RECOVERY_DELAY_MIN=30
TICTO_CHECKOUT_PATH=O3EB65FBD
TICTO_WEBHOOK_SECRET=

# Cakto (pay.cakto.com.br) — migração gradual de pagamento, teste A/B em /raiz-cakto.
# Fase de captura: o webhook /api/webhooks/cakto valida este secret (o mesmo que
# a Cakto envia no campo "secret" do payload) e grava em cakto:* (isolado do Ticto).
CAKTO_WEBHOOK_SECRET=
# Purchase CAPI do Cakto: sem pixel na Cakto, a compra vai ao Meta só via CAPI.
# 'true' liga o envio real (event_id = id da transação, dedup no Meta).
CAKTO_PURCHASE_CAPI_ENABLED=false
# Path da oferta no checkout Cakto (usado no link dinâmico da recuperação).
CAKTO_CHECKOUT_PATH=pjgpde8_1000061
# Template aprovado da recuperação de checkout do Cakto (URL dinâmica pay.cakto.com.br/{{1}}).
WHATSAPP_RECOVERY_TEMPLATE_CAKTO=recuperacao_checkout_cakto
# Início do teste A/B Ticto vs Cakto (YYYY-MM-DD) — corta o /tictovscakto a partir daqui.
AB_START_DATE=

# Sequência pós-quiz (fase 1: mensagem de 4h para quem não iniciou checkout)
SEQ_ENABLED=false
SEQ_TEMPLATE_4H=recuperacao_4h
SEQ_DELAY_4H_MIN=240

# ─── LIA — onboarding pós-compra ─────────────────────────────────────────────
# API do backend da LIA (repo próprio). Enquanto vazio, o onboarding é
# persistido no Redis e a fila de retry drena sozinha quando a URL existir.
LIA_API_URL=
LIA_API_SECRET=
# offer.id da LIA na Cakto — o webhook /api/webhooks/cakto é compartilhado com
# o Protocolo Raiz, então sem isso não dá pra distinguir a compra da LIA.
LIA_CAKTO_OFFER_ID=

# ─── LIA na Ticto ────────────────────────────────────────────────────────────
# O Raiz migrou pra Cakto, então tudo que chega na Ticto é tratado como LIA por
# padrão — exceto a oferta do Raiz (TICTO_CHECKOUT_PATH), que a recuperação de
# carrinho por WhatsApp ainda pode gerar. Deixe VAZIO a menos que queira uma
# allowlist explícita.
LIA_TICTO_OFFERS=
# Pixel PRÓPRIO da LIA. Sem ele, o Purchase da LIA não é enviado (de propósito:
# melhor não enviar do que enviar pro pixel do Raiz).
LIA_PIXEL_ID=
LIA_CAPI_TOKEN=
# Checkouts usados pelo /mapa-lia. Os defaults atuais são os mesmos da LP /lia.
LIA_CHECKOUT_MONTHLY=https://payment.ticto.app/OAC407884
LIA_CHECKOUT_ANNUAL=https://payment.ticto.app/O599B4571
